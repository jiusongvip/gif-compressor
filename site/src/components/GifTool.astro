---
import Icon from "./Icon.astro";
---

<div id="gif-tool" class="w-full">
  <!-- Drop Zone -->
  <div id="drop-zone" aria-label="Drop zone for GIF files"
    class="tool-card border-dashed p-8 md:p-14 text-center cursor-pointer transition-all duration-150">
    <div class="mx-auto w-14 h-14 md:w-16 md:h-16 mb-4 md:mb-5 rounded-2xl bg-accent/5 flex items-center justify-center">
      <Icon name="upload" size={32} class="text-accent" />
    </div>
    <h2 class="text-lg font-semibold text-slate-900 mb-1.5">Drop your GIF here</h2>
    <p class="text-sm text-slate-400 mb-5 max-w-xs mx-auto leading-relaxed">
      Click anywhere in this box to pick a file, or press <kbd class="px-1 py-0.5 rounded border border-slate-200 bg-slate-50 text-[11px] text-slate-500 font-sans">Ctrl</kbd><span class="text-slate-300">+</span><kbd class="px-1 py-0.5 rounded border border-slate-200 bg-slate-50 text-[11px] text-slate-500 font-sans">V</kbd> to paste one.
    </p>
    <div class="flex flex-col items-center gap-2.5">
      <button id="select-btn" type="button"
        class="px-6 py-3 bg-accent text-white text-sm font-medium rounded-lg hover:bg-accent-dark transition-colors active:scale-[0.98]">
        Select GIF
      </button>
      <p class="text-xs text-slate-400">Free &middot; Max 100MB &middot; Never uploaded</p>
      <button id="url-toggle" type="button"
        class="text-xs text-slate-400 hover:text-accent underline underline-offset-2 transition-colors">
        or paste a GIF URL
      </button>
      <div id="url-row" class="items-center gap-2 w-full max-w-sm" style="display:none" onclick="event.stopPropagation()">
        <input type="text" id="url-input" aria-label="GIF URL input" placeholder="https://example.com/animation.gif"
          class="flex-1 px-3 py-2 text-xs border border-slate-200 rounded-lg text-slate-600 placeholder:text-slate-300
            focus:outline-none focus:border-accent/50 focus:ring-1 focus:ring-accent/20 transition-colors" />
        <button id="url-load-btn" aria-label="Load GIF from URL" type="button"
          class="px-3 py-2 text-xs font-medium text-accent border border-accent/30 rounded-lg hover:bg-accent/5
            active:scale-[0.98] transition-colors whitespace-nowrap">
          Load
        </button>
      </div>
    </div>
    <input type="file" id="file-input" accept="image/gif,.gif" class="hidden" />
  </div>

  <!-- Progress Bar -->
  <div id="progress-bar" class="hidden mt-4 w-full bg-slate-100 rounded-full h-1.5 overflow-hidden">
    <div id="progress-fill" class="h-full bg-accent rounded-full transition-all duration-300 ease-out" style="width:0%"></div>
  </div>
  <p id="progress-text" class="text-xs text-slate-400 mt-1.5 text-center"></p>

  <!-- Tool Panel -->
  <div id="tool-panel" class="hidden mt-5 space-y-4">

    <!-- 1. RESULT — what the user came for, above everything else -->
    <div id="result-card" class="tool-card p-5">
      <p class="text-[10px] uppercase tracking-wider text-slate-400 font-semibold mb-3">Your result</p>
      <div class="flex items-baseline gap-3 flex-wrap">
        <span id="result-orig" class="text-base text-slate-400 line-through tabular-nums">-</span>
        <span class="text-slate-300 text-lg">&rarr;</span>
        <span id="result-comp" class="text-3xl font-bold text-accent leading-none tabular-nums">-</span>
        <span id="result-saved" class="text-xs font-semibold text-emerald-700 bg-emerald-50 px-2 py-1 rounded-md">-</span>
      </div>
      <p id="result-note" class="text-xs text-slate-400 mt-2 mb-4 leading-relaxed"></p>
      <button id="download-btn" aria-label="Download compressed GIF" disabled
        class="w-full py-3 bg-accent text-white text-sm font-medium rounded-lg hover:bg-accent-dark transition-colors
          active:scale-[0.98] disabled:opacity-40 disabled:cursor-not-allowed disabled:active:scale-100 inline-flex items-center justify-center gap-2">
        <Icon name="download" size={16} class="text-white" />
        Download Compressed GIF
      </button>
      <div class="flex items-center justify-between mt-2.5">
        <span id="speed-badge" class="hidden text-[10px] text-accent font-medium"></span>
        <button id="reset-btn" aria-label="Compress another GIF"
          class="text-xs text-slate-400 hover:text-slate-600 transition-colors ml-auto">
          Compress another GIF
        </button>
      </div>
    </div>

    <!-- 2. RESULT — the compressed GIF itself, playing. This slot used to hold the
         drag-to-compare slider, which framed the moment as "hunt for damage"; what
         the user needs to see first is that the file they are about to download
         still works. The slider moved down to the small card. -->
    <div class="tool-card overflow-hidden">
      <div class="p-3 border-b border-slate-100 flex items-center justify-between gap-3">
        <span class="text-[10px] uppercase tracking-wider text-slate-500 font-semibold">Compressed</span>
        <button id="open-lightbox" type="button" class="text-[10px] text-accent hover:underline whitespace-nowrap">
          Compare before / after
        </button>
      </div>
      <div class="relative w-full bg-slate-50 flex items-center justify-center"
        style="height: clamp(200px, 34vh, 360px);">
        <img id="preview-comp" src="data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs=" alt="Your compressed GIF" width="600" height="600" class="max-w-full max-h-full object-contain" />
      </div>
    </div>

    <!-- 3. CONTROLS -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
      <!-- Left: before/after slider, deliberately small — the hero above is the result -->
      <div class="tool-card p-4 lg:col-span-1">
        <div class="flex items-center justify-between mb-3">
          <p class="text-[10px] uppercase tracking-wider text-slate-400 font-semibold">Before / after</p>
          <span class="text-[10px] text-slate-400">drag</span>
        </div>
        <div id="comparison-wrap" class="comparison-wrap relative w-full aspect-square bg-slate-50 rounded-md border border-slate-100 overflow-hidden cursor-ew-resize">
          <img id="comparison-orig" class="absolute inset-0 w-full h-full object-contain" src="data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs=" alt="Original GIF" width="200" height="200" />
          <img id="comparison-comp" class="absolute inset-0 w-full h-full object-contain" src="data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs=" alt="Compressed GIF" width="200" height="200" style="clip-path: inset(0 0 0 50%);" />
          <div id="compare-line" class="absolute top-0 bottom-0 w-0.5 bg-white shadow-lg pointer-events-none z-10" style="left: 50%;"></div>
          <input type="range" id="compare-handle" aria-label="Before and after comparison slider" min="0" max="100" value="50"
            class="absolute inset-0 w-full h-full opacity-0 cursor-ew-resize z-20" />
        </div>
        <div class="flex justify-between mt-2 gap-2">
          <span class="text-[10px] text-slate-400 truncate">Original <span id="orig-size" class="tabular-nums"></span></span>
          <span class="text-[10px] text-slate-400 truncate">Compressed <span id="comp-size" class="tabular-nums"></span></span>
        </div>
      </div>

      <!-- Right: Controls -->
      <div class="tool-card p-4 lg:col-span-2">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- Left column: Analysis + Mode + Presets -->
          <div class="space-y-4">
            <div>
              <p class="text-[10px] uppercase tracking-wider text-slate-400 font-semibold mb-2">Analysis</p>
              <!-- Every row is a measured value: what went in, what came out. -->
              <div id="analysis" class="text-xs">
                {[
                  { k: 'size', label: 'Size' },
                  { k: 'dims', label: 'Dimensions' },
                  { k: 'frames', label: 'Frames' },
                  { k: 'colors', label: 'Colors' },
                ].map((row, i, all) => (
                  <div class={'flex items-center justify-between py-1' + (i < all.length - 1 ? ' border-b border-slate-50' : '')}>
                    <span class="text-slate-500">{row.label}</span>
                    <span class="tabular-nums whitespace-nowrap">
                      <span id={'an-' + row.k + '-in'} class="text-slate-400">-</span>
                      <span class="text-slate-300 mx-1">&rarr;</span>
                      <span id={'an-' + row.k + '-out'} class="text-slate-900 font-medium">-</span>
                    </span>
                  </div>
                ))}
              </div>
            </div>

            <div>
              <p class="text-[10px] uppercase tracking-wider text-slate-400 font-semibold mb-2">Mode</p>
              <div class="grid grid-cols-3 gap-1 bg-slate-100 rounded-lg p-1">
                <button data-mode="quality" class="mode-btn py-1.5 text-[11px] font-medium rounded-md transition-colors text-slate-500 hover:text-slate-900">Quality</button>
                <button data-mode="balanced" class="mode-btn py-1.5 text-[11px] font-medium rounded-md transition-colors bg-accent text-white">Balanced</button>
                <button data-mode="max" class="mode-btn py-1.5 text-[11px] font-medium rounded-md transition-colors text-slate-500 hover:text-slate-900">Max</button>
              </div>
            </div>

            <div>
              <p class="text-[10px] uppercase tracking-wider text-slate-400 font-semibold mb-2">Target size</p>
              <div id="preset-buttons" class="flex flex-wrap gap-1.5"></div>
            </div>
          </div>

          <!-- Right column: Level + Applied + Fits + funnel -->
          <div class="space-y-4 flex flex-col">
            <div>
              <div class="flex justify-between mb-2">
                <p class="text-[10px] uppercase tracking-wider text-slate-400 font-semibold">Level</p>
                <span id="level-val" class="text-xs text-slate-900 font-medium tabular-nums">75</span>
              </div>
              <input type="range" id="level-slider" aria-label="Compression level" min="0" max="100" value="75"
                class="w-full h-1.5 bg-slate-200 rounded-full appearance-none cursor-pointer accent-accent
                  [&::-webkit-slider-thumb]:appearance-none [&::-webkit-slider-thumb]:w-4 [&::-webkit-slider-thumb]:h-4
                  [&::-webkit-slider-thumb]:bg-accent [&::-webkit-slider-thumb]:rounded-full [&::-webkit-slider-thumb]:shadow-sm
                  [&::-webkit-slider-thumb]:transition-transform [&::-webkit-slider-thumb]:hover:scale-110" />
            </div>

            <div>
              <p class="text-[10px] uppercase tracking-wider text-slate-400 font-semibold mb-2">Applied</p>
              <div id="applied" class="text-xs">
                <div class="flex justify-between py-1"><span class="text-slate-500">Setting</span><span id="ap-setting" class="text-slate-900 font-medium">-</span></div>
                <div id="ap-flags" class="mt-1 px-2 py-1.5 rounded-md bg-slate-50 text-slate-600 font-mono text-[10px] break-all">-</div>
              </div>
            </div>

            <div>
              <p class="text-[10px] uppercase tracking-wider text-slate-400 font-semibold mb-2">Fits where</p>
              <div id="fit-chips" class="flex flex-wrap gap-1.5"></div>
            </div>

            <!-- Post-compression funnel -->
            <div id="post-compress-funnel" class="hidden mt-auto pt-3 border-t border-slate-100">
              <p class="text-[10px] uppercase tracking-wider text-slate-400 font-semibold mb-2">Save even more</p>
              <div class="space-y-1.5">
                <a href="/gif-to-webp/" class="flex items-center gap-1.5 text-[11px] text-accent hover:underline">
                  <span>&rarr;</span> Convert to WebP (save ~80% more)
                </a>
                <a href="/gif-to-mp4/" class="flex items-center gap-1.5 text-[11px] text-accent hover:underline">
                  <span>&rarr;</span> Convert to MP4 (save ~90% more)
                </a>
                <a href="/resize-gif/" class="flex items-center gap-1.5 text-[11px] text-accent hover:underline">
                  <span>&rarr;</span> Resize GIF for smaller dimensions
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div id="toast" class="hidden fixed bottom-6 left-1/2 -translate-x-1/2 bg-slate-800 text-white text-xs px-4 py-2 rounded-lg shadow-lg z-50 opacity-100 pointer-events-none"></div>
  </div>

  <!-- Sticky result bar.
       Pinned under the nav while the user works the controls further down, so
       cause (Mode / Level / Target size) and effect (the resulting size and the
       download button) are never a screen apart. Shown by JS only once a result
       exists AND the main result card has scrolled out of view; it is
       position:fixed so appearing never shifts the layout underneath. -->
  <div id="sticky-result" class="fixed left-0 right-0 z-30 pointer-events-none"
    style="display:none; top:64px" aria-hidden="true">
    <div class="max-w-4xl mx-auto px-4">
      <div class="tool-card pointer-events-auto px-4 py-2.5 flex items-center gap-3 shadow-md">
        <span id="sticky-orig" class="text-xs text-slate-400 line-through tabular-nums">-</span>
        <span class="text-slate-300 text-sm">&rarr;</span>
        <span id="sticky-comp" class="text-lg font-bold text-accent leading-none tabular-nums">-</span>
        <span id="sticky-saved" class="text-[10px] font-semibold text-emerald-700 bg-emerald-50 px-1.5 py-0.5 rounded">-</span>
        <button id="sticky-download" type="button" aria-label="Download compressed GIF"
          class="ml-auto px-4 py-1.5 bg-accent text-white text-xs font-medium rounded-lg hover:bg-accent-dark
            transition-colors active:scale-[0.98] whitespace-nowrap">
          Download
        </button>
      </div>
    </div>
  </div>

  <!-- Lightbox: full-size quality comparison -->
  <div id="lightbox" class="fixed inset-0 z-50 bg-slate-900/85 p-4 md:p-8 overflow-auto"
    style="display:none" role="dialog" aria-modal="true" aria-label="Full size quality comparison">
    <button id="lightbox-close" type="button"
      class="absolute top-4 right-4 px-3 py-1.5 rounded-lg bg-white/10 text-white text-xs hover:bg-white/20 transition-colors">
      Close
    </button>
    <div class="max-w-5xl mx-auto mt-10 grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <p class="text-white/80 text-xs mb-2">Original <span id="lightbox-orig-size" class="text-white/50 tabular-nums"></span></p>
        <img id="lightbox-orig" class="w-full rounded-lg bg-white/5" alt="Original GIF at full size" />
      </div>
      <div>
        <p class="text-white/80 text-xs mb-2">Compressed <span id="lightbox-comp-size" class="text-white/50 tabular-nums"></span></p>
        <img id="lightbox-comp" class="w-full rounded-lg bg-white/5" alt="Compressed GIF at full size" />
      </div>
    </div>
  </div>
</div>

<script type="module" src="/js/gif-compressor.js"></script>
<script type="module" src="/js/batch-compressor.js"></script>
