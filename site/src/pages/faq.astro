---
import Base from "../layouts/Base.astro";

const faqs = [
  { cat: "Compression", q: "How does GIF compression work?", a: 'GIF compression combines three techniques: <strong>color palette reduction</strong> (fewer colors = smaller file), <strong>frame rate optimization</strong> (dropping duplicate or near-duplicate frames), and <strong>lossy LZW encoding</strong> (merging similar pixel colors). Our <a href="/" class="text-accent hover:underline">GIF compressor</a> analyzes your file and applies the optimal combination.' },
  { cat: "Compression", q: "Will compressing my GIF affect the animation?", a: "At moderate compression levels, the animation stays smooth and visually nearly identical. At aggressive levels, you may notice color banding or reduced frame count. Use the <strong>live preview</strong> and comparison slider to find the right balance." },
  { cat: "Compression", q: "How much can I reduce a GIF file size?", a: "Typical results: 20-35% in Quality mode (photos, complex scenes), 35-55% in Balanced mode (general purpose), and 50-70% in Maximum mode (memes, simple graphics). You can also <a href=\"/resize-gif\" class=\"text-accent hover:underline\">resize dimensions</a> first for even larger savings." },
  { cat: "Compression", q: "What is the difference between resizing and compressing?", a: "Resizing changes the <strong>pixel dimensions</strong> (e.g. 800×600 to 400×300). Compressing reduces the <strong>file size</strong> without changing dimensions, by optimizing the internal data. Both are complementary — resize then compress for maximum reduction." },
  { cat: "Compression", q: "What is the difference between the basic compressor and the advanced optimizer?", a: 'The <a href="/" class="text-accent hover:underline">basic compressor</a> gives you three modes and a single slider — the tool picks the best strategy automatically. The <a href="/gif-optimizer/" class="text-accent hover:underline">advanced optimizer</a> exposes every parameter individually: color palette size, frame rate, and lossy LZW level — for developers who need precise control.' },
  { cat: "Formats", q: "Should I use GIF, WebP, or MP4?", a: '<strong>GIF</strong> for short memes and stickers (universal support). <a href="/gif-to-webp/" class="text-accent hover:underline">WebP</a> for modern web animations (60-90% smaller, full alpha transparency). <a href="/gif-to-mp4/" class="text-accent hover:underline">MP4</a> for anything over 5 seconds or photographic content (80-95% smaller).' },
  { cat: "Formats", q: "Why is my GIF file so large?", a: "GIF stores every frame as a complete image with up to 256 colors. A 400×400 GIF at 30fps stores nearly 5 million pixel references per second. Long animations, many colors, large dimensions, and subtle gradients all increase file size dramatically." },
  { cat: "Formats", q: "Can I convert GIF to WebP or MP4?", a: 'Yes. Use our <a href="/gif-to-webp/" class="text-accent hover:underline">GIF to WebP converter</a> for 60-90% smaller files with better quality, or the <a href="/gif-to-mp4/" class="text-accent hover:underline">GIF to MP4 converter</a> for dramatic savings on long animations and screen recordings.' },
  { cat: "Formats", q: "What is the maximum file size supported?", a: "100MB per file for the compressor, optimizer, resize, crop, and batch tools; 50MB for the <a href=\"/gif-to-webp\" class=\"text-accent hover:underline\">GIF to WebP</a> and <a href=\"/gif-to-mp4\" class=\"text-accent hover:underline\">GIF to MP4</a> converters. For very large GIFs, consider splitting the animation or converting to MP4 first — the format conversion alone often brings it below 10MB before any compression." },
  { cat: "Privacy", q: "Is my file safe? Do you store my GIFs?", a: "<strong>Yes, completely safe.</strong> All processing happens inside your browser. Your GIF never leaves your device. We do not upload, store, or have access to your files. Nothing is sent to any server." },
  { cat: "Privacy", q: "Why does client-side processing matter?", a: "Many online tools upload your GIF to their server for processing. This means your file — possibly containing personal photos, internal company demos, or unreleased artwork — is exposed. Our browser-based approach keeps everything on your device." },
  { cat: "Usage", q: "Can I compress multiple GIFs at once?", a: "Yes. Toggle <strong>Batch mode</strong> to compress multiple GIFs simultaneously. All files are processed with the same compression settings and can be downloaded as a single ZIP file." },
  { cat: "Usage", q: "How do I compress a GIF for Discord?", a: 'Use the <strong>&lt;8MB Discord preset</strong> button in the tool, or manually set Balanced mode at level 60-80. For best results, also <a href="/resize-gif/" class="text-accent hover:underline">resize to 600-800px width</a> before compressing. See our <a href="/reduce-gif-size/" class="text-accent hover:underline">platform size guide</a> for more targets.' },
  { cat: "Usage", q: "How do I compress a GIF for Twitter?", a: 'Twitter limits GIFs to 5MB on web and 3MB on mobile. Use the <strong>&lt;5MB Twitter preset</strong>, or Maximum mode at level 70-90. If that is not enough, resize to 600px width first — this often brings even 15MB GIFs within limits.' },
  { cat: "Usage", q: "Does this tool work on mobile?", a: "Yes. Our tool is fully responsive and works on iOS and Android. You can upload GIFs from your camera roll, compress them, and download — all from your phone browser." },
];

const cats = [...new Set(faqs.map(f => f.cat))];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a.replace(/<[^>]*>/g, '') }
  }))
});
---
<Base title="GIF Compressor FAQ — Compression, Formats, Privacy &amp; Usage" description="Complete FAQ: how GIF compression works, file safety, GIF vs WebP vs MP4, platform size limits, and usage tips. 100% private browser-based processing." schema={faqSchema}>
  <div class="max-w-2xl mx-auto px-4 pt-10 pb-16">
    <h1 class="text-2xl font-bold text-slate-900 mb-2">Frequently Asked Questions</h1>
    <p class="text-sm text-slate-500 mb-10">Everything you need to know about GIF compression, formats, privacy, and usage.</p>
    {cats.map((cat) => (
      <div class="mb-10">
        <h2 class="text-sm font-semibold text-slate-400 uppercase tracking-wider mb-4">{cat}</h2>
        <div class="space-y-3">
          {faqs.filter(f => f.cat === cat).map((faq) => (
            <details class="group tool-card p-5">
              <summary class="text-sm font-medium text-slate-900 cursor-pointer list-none flex justify-between items-center">
                {faq.q}
                <span class="text-slate-300 group-open:rotate-180 transition-transform ml-4 shrink-0">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
                </span>
              </summary>
              <p class="text-sm text-slate-500 mt-3 leading-relaxed" set:html={faq.a} />
            </details>
          ))}
        </div>
      </div>
    ))}
    <div class="mt-10 pt-6 border-t border-slate-100 text-center">
      <p class="text-xs text-slate-400">Did not find your answer? <a href="/" class="text-accent hover:underline">Try the compressor</a> or check the <a href="/blog/" class="text-accent hover:underline">blog</a> for detailed guides.</p>
    </div>
  </div>
</Base>
