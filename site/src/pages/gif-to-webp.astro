---
import Base from "../layouts/Base.astro";


const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "How much smaller is WebP than GIF?", "acceptedAnswer": { "@type": "Answer", "text": "Animated WebP is typically 60-90% smaller than GIF at the same visual quality. A 5MB GIF often becomes 300-900KB as WebP. WebP uses modern VP8/VP9 intra-frame coding." } },
    { "@type": "Question", "name": "Does WebP support animation and transparency?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Animated WebP supports both full animation and alpha-channel transparency, unlike GIF which only has binary transparency. WebP transparency supports 256 levels of opacity." } },
    { "@type": "Question", "name": "Is WebP supported in all browsers?", "acceptedAnswer": { "@type": "Answer", "text": "WebP has 97%+ global browser support. All modern browsers support it: Chrome, Firefox, Safari 14+, Edge, and Opera. The main exception is very old browsers and some email clients." } }
  ]
});


const webAppSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "GIF to WebP Converter",
  "url": Astro.url.href,
  "description": "Convert animated GIF to WebP online free. WebP files are 60-90% smaller than GIF with full alpha transparency.",
  "applicationCategory": "Multimedia",
  "operatingSystem": "Any",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "featureList": ["GIF to WebP Conversion", "60-90% Size Reduction", "Alpha Transparency Support", "Browser-based Processing", "Instant Conversion"]
});---



<Base
    title="GIF to WebP Converter — 60-90% Smaller Animated Images"
  description="Convert animated GIF to WebP online free. WebP is 60-90% smaller than GIF with better quality and full transparency. Instant in-browser conversion.">
<div class="max-w-4xl mx-auto px-4 pt-8 pb-6">
