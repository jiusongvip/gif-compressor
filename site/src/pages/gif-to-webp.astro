    </div>
    <div class="mt-6 text-center"><button id="download-btn" disabled class="px-5 py-2.5 bg-accent text-white text-sm font-medium rounded-lg hover:bg-accent-dark transition-colors active:scale-[0.98] disabled:opacity-40 disabled:cursor-not-allowed">Download WebP</button></div>
