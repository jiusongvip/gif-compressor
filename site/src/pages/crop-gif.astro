---
import Base from "../layouts/Base.astro";


const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "Can I crop an animated GIF without losing animation?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Every frame is cropped with the same rectangle, and frame delays and disposal methods are copied through unchanged. The result plays at exactly the original speed, only inside the area you selected." } },
    { "@type": "Question", "name": "What aspect ratios can I crop to?", "acceptedAnswer": { "@type": "Answer", "text": "You can crop freely, or lock the selection to a preset ratio: 1:1 (square), 4:3, 3:4, 16:9 and 9:16 (vertical). Square is the shape profile pictures and stickers need; 9:16 is the shape of a phone screen." } },
    { "@type": "Question", "name": "Does cropping a GIF reduce its file size?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Cropping deletes pixels from every frame, so the file gets smaller. A crop that keeps half the width and half the height kept between a fifth and a half of the original weight in our own tests, depending on how much of the animation moves. Compress the cropped file afterwards for the rest." } },
    { "@type": "Question", "name": "How do I cut out a watermark or a fixed region?", "acceptedAnswer": { "@type": "Answer", "text": "Type the X and Y of the top-left corner you want to keep plus the width and height, all in the original GIF's own pixels, then press Crop GIF. The preview on the right plays the real output, so you can check that the watermark is gone before downloading." } }
  ]
});


const webAppSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "GIF Cropper",
  "url": Astro.url.href,
  "description": "Crop animated GIFs online free. Remove unwanted edges, set custom aspect ratios, and trim every frame.",
  "applicationCategory": "Multimedia",
  "operatingSystem": "Any",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "featureList": ["GIF Cropping", "Custom Aspect Ratios", "Edge Trimming", "Browser-based Processing", "Instant Processing"]
});---



<Base
  title="Crop GIF Online Free - Trim Animated GIFs in Your Browser"
  description="Crop animated GIFs online free. Remove edges, set custom aspect ratios, and trim every frame — all in your browser. No uploads or watermarks, instant preview."
 schemas={[webAppSchema, faqSchema]}>
<div class="max-w-4xl mx-auto px-4 pt-8 pb-6">
  <h1 class="text-2xl font-bold text-slate-900 leading-tight">
    Crop GIF <span class="text-accent">Online</span>
  </h1>
  <p class="text-sm text-slate-500 mt-2 max-w-xl leading-relaxed">
    Trim the edges of your animated GIF. Set custom aspect ratios, remove watermarks, or focus on the important part. All processed in your browser.
  </p>
</div>

<div class="max-w-4xl mx-auto px-4">
  <div id="crop-tool" class="tool-card p-10 md:p-14 text-center cursor-pointer transition-all duration-150">
    <div class="mx-auto w-16 h-16 mb-6 rounded-2xl bg-accent/5 flex items-center justify-center">
      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="text-accent" stroke-width="1.5"><circle cx="6" cy="6" r="3"/><path d="M8.12 8.12 12 12M20 4 8.12 15.88"/><circle cx="6" cy="18" r="3"/><path d="M14.8 14.8 20 20"/></svg>
    </div>
    <h2 class="text-lg font-semibold text-slate-900 mb-2">Drop your GIF here</h2>
    <p class="text-sm text-slate-400 mb-5">Select a GIF to start cropping</p>
    <button id="select-btn" type="button" class="px-5 py-2.5 bg-accent text-white text-sm font-medium rounded-lg hover:bg-accent-dark transition-colors active:scale-[0.98]">Select GIF File</button>
    <input type="file" id="file-input" accept="image/gif,.gif" class="hidden" />
    <div class="flex items-center justify-center gap-2 w-full max-w-sm mt-3 mx-auto" onclick="event.stopPropagation()">
      <input type="text" id="url-input" placeholder="Or paste a GIF URL..."
        class="flex-1 px-3 py-2 text-xs border border-slate-200 rounded-lg text-slate-600 placeholder:text-slate-300 focus:outline-none focus:border-accent/50" />
      <button id="url-load-btn" type="button"
        class="px-3 py-2 text-xs font-medium text-accent border border-accent/30 rounded-lg hover:bg-accent/5 transition-colors whitespace-nowrap">
        Load
      </button>
    </div>
  </div>

  <div id="editor-panel" class="hidden mt-6 tool-card overflow-hidden">
    <div class="flex flex-col lg:flex-row">
      <div class="flex-1 p-4 relative bg-slate-50 flex items-center justify-center min-h-[400px]">
        <div id="crop-stage" class="relative inline-block max-w-full">
          <canvas id="crop-canvas" class="block max-w-full h-auto"></canvas>
          <div id="crop-overlay" class="absolute border-2 border-accent bg-accent/10 cursor-move hidden"></div>
        </div>
      </div>
      <div class="w-px bg-slate-100 hidden lg:block"></div>
      <div class="p-5 lg:w-72 flex flex-col gap-4">
        <div>
          <p class="text-[10px] uppercase tracking-wider text-slate-400 font-semibold mb-2">Crop Area <span id="src-dims" class="normal-case font-normal"></span></p>
          <div class="grid grid-cols-2 gap-2">
            <div><label class="text-[10px] text-slate-400">X</label><input type="number" id="crop-x" min="0" class="w-full px-2 py-1.5 border border-slate-200 rounded text-xs focus:outline-none focus:border-accent" value="0" /></div>
            <div><label class="text-[10px] text-slate-400">Y</label><input type="number" id="crop-y" min="0" class="w-full px-2 py-1.5 border border-slate-200 rounded text-xs focus:outline-none focus:border-accent" value="0" /></div>
            <div><label class="text-[10px] text-slate-400">W</label><input type="number" id="crop-w" min="1" class="w-full px-2 py-1.5 border border-slate-200 rounded text-xs focus:outline-none focus:border-accent" value="200" /></div>
            <div><label class="text-[10px] text-slate-400">H</label><input type="number" id="crop-h" min="1" class="w-full px-2 py-1.5 border border-slate-200 rounded text-xs focus:outline-none focus:border-accent" value="200" /></div>
          </div>
        </div>
        <div>
          <p class="text-[10px] uppercase tracking-wider text-slate-400 font-semibold mb-2">Preset Ratios</p>
          <div class="grid grid-cols-3 gap-1.5">
            <button data-ratio="1:1" class="ratio-btn py-1.5 text-[11px] border border-slate-200 rounded hover:border-accent hover:text-accent transition-colors">1:1</button>
            <button data-ratio="4:3" class="ratio-btn py-1.5 text-[11px] border border-slate-200 rounded hover:border-accent hover:text-accent transition-colors">4:3</button>
            <button data-ratio="16:9" class="ratio-btn py-1.5 text-[11px] border border-slate-200 rounded hover:border-accent hover:text-accent transition-colors">16:9</button>
            <button data-ratio="3:4" class="ratio-btn py-1.5 text-[11px] border border-slate-200 rounded hover:border-accent hover:text-accent transition-colors">3:4</button>
            <button data-ratio="9:16" class="ratio-btn py-1.5 text-[11px] border border-slate-200 rounded hover:border-accent hover:text-accent transition-colors">9:16</button>
            <button data-ratio="free" class="ratio-btn py-1.5 text-[11px] border border-slate-200 rounded hover:border-accent hover:text-accent transition-colors bg-slate-100">Free</button>
          </div>
        </div>
        <button id="apply-btn" class="w-full py-2.5 bg-accent text-white text-sm font-medium rounded-lg hover:bg-accent-dark transition-colors active:scale-[0.98] disabled:opacity-40">Crop GIF</button>
        <p id="crop-status" class="text-xs text-slate-500 leading-relaxed">Drag the box on the left or type the coordinates. Sizes are in the GIF's own pixels.</p>
        <button id="download-btn" class="w-full py-2.5 border border-accent text-accent text-sm font-medium rounded-lg hover:bg-accent/5 transition-colors active:scale-[0.98] disabled:opacity-40 disabled:cursor-not-allowed" disabled>Download Cropped GIF</button>
      </div>
    </div>

    <div id="result-wrap" class="hidden border-t border-slate-100 p-5 bg-slate-50/60">
      <p class="text-[10px] uppercase tracking-wider text-slate-400 font-semibold mb-3">Cropped Result</p>
      <div class="flex flex-col sm:flex-row items-center gap-4">
        <img id="crop-result" alt="Cropped GIF preview, playing every frame of the animation" class="max-h-[280px] max-w-[280px] rounded bg-white border border-slate-200 object-contain" />
        <p id="crop-note" class="text-xs text-slate-500 leading-relaxed sm:max-w-[22rem]"></p>
      </div>
    </div>
  </div>
</div>

<article class="max-w-2xl mx-auto px-4 mt-16 pb-12">
  <h2 class="text-xl font-bold text-slate-900 mb-4">Why Crop a GIF? 5 Common Scenarios</h2>
  <p class="text-sm text-slate-600 leading-relaxed mb-4">Cropping removes unwanted areas from your GIF — permanently deleting those pixels from every frame. Unlike compression (which reduces file size by optimizing internal data), cropping physically cuts away content. This makes it both a creative and a file-size tool.</p>
  <ul class="space-y-3 mb-6">
    <li class="text-sm text-slate-600"><strong class="text-slate-800">Remove watermarks and logos.</strong> Downloaded a GIF with a watermark in the corner? Crop it out and reclaim clean content.</li>
    <li class="text-sm text-slate-600"><strong class="text-slate-800">Fit a specific aspect ratio.</strong> A 16:9 GIF needs to become 1:1 for a profile picture. Cropping — not stretching — is the correct approach.</li>
    <li class="text-sm text-slate-600"><strong class="text-slate-800">Focus on the subject.</strong> Your GIF shows a person reacting, but the frame is mostly background. Crop to the face and body.</li>
    <li class="text-sm text-slate-600"><strong class="text-slate-800">Clean up screen recordings.</strong> Recordings often have browser chrome, taskbars, or desktop clutter at the edges. Crop to the content area.</li>
    <li class="text-sm text-slate-600"><strong class="text-slate-800">Reduce file size instantly.</strong> Cropping 20% off each edge removes 36% of the pixels per frame. Combined with compression afterwards, total savings can exceed 80%.</li>
  </ul>

  <h2 class="text-xl font-bold text-slate-900 mt-10 mb-4">Crop First, Then Compress — The Correct Order</h2>
  <p class="text-sm text-slate-600 leading-relaxed mb-4">The optimization order matters. If you compress first and crop second, you wasted CPU cycles and quality on pixels you then delete. Always crop first to permanently remove unwanted data, then compress the smaller result. For maximum savings: <strong class="text-slate-800">Crop → Resize → Compress</strong>. This triple approach routinely achieves 85-95% total file size reduction.</p>

  <h2 class="text-xl font-bold text-slate-900 mt-10 mb-4">Best Aspect Ratios for Every Platform</h2>
  <div class="overflow-x-auto mb-6"><table class="w-full text-sm border-collapse">
    <thead><tr class="border-b-2 border-slate-200 text-left"><th class="py-2.5 pr-4 text-slate-500 font-medium text-xs">Platform</th><th class="py-2.5 pr-4 text-slate-500 font-medium text-xs">Best ratio</th><th class="py-2.5 pr-4 text-slate-500 font-medium text-xs">Ideal dimensions</th><th class="py-2.5 text-slate-500 font-medium text-xs">Why</th></tr></thead>
    <tbody>
      <tr class="border-b border-slate-100"><td class="py-2.5 pr-4 text-xs font-medium text-slate-700">Discord chat</td><td class="py-2.5 pr-4 text-xs">Any (up to 20MB)</td><td class="py-2.5 pr-4 text-xs">480-600px wide</td><td class="py-2.5 text-xs text-slate-500">No forced ratio. Crop for focus.</td></tr>
      <tr class="border-b border-slate-100"><td class="py-2.5 pr-4 text-xs font-medium text-slate-700">Twitter / X feed</td><td class="py-2.5 pr-4 text-xs">16:9 or 1:1</td><td class="py-2.5 pr-4 text-xs">1200×675 or 800×800</td><td class="py-2.5 text-xs text-slate-500">Feed crops to these ratios on some views</td></tr>
      <tr class="border-b border-slate-100"><td class="py-2.5 pr-4 text-xs font-medium text-slate-700">Instagram Stories</td><td class="py-2.5 pr-4 text-xs">9:16</td><td class="py-2.5 pr-4 text-xs">1080×1920</td><td class="py-2.5 text-xs text-slate-500">Full-screen vertical. Convert to MP4.</td></tr>
      <tr class="border-b border-slate-100"><td class="py-2.5 pr-4 text-xs font-medium text-slate-700">Instagram Post</td><td class="py-2.5 pr-4 text-xs">1:1 or 4:5</td><td class="py-2.5 pr-4 text-xs">1080×1080 or 1080×1350</td><td class="py-2.5 text-xs text-slate-500">Square or vertical. Feed standard.</td></tr>
      <tr class="border-b border-slate-100"><td class="py-2.5 pr-4 text-xs font-medium text-slate-700">YouTube thumbnail</td><td class="py-2.5 pr-4 text-xs">16:9</td><td class="py-2.5 pr-4 text-xs">1280×720</td><td class="py-2.5 text-xs text-slate-500">Standard video thumbnail ratio</td></tr>
      <tr class="border-b border-slate-100"><td class="py-2.5 pr-4 text-xs font-medium text-slate-700">Email header</td><td class="py-2.5 pr-4 text-xs">Any (under 1MB)</td><td class="py-2.5 pr-4 text-xs">600px wide max</td><td class="py-2.5 text-xs text-slate-500">Email columns are narrow</td></tr>
      <tr class="border-b border-slate-100"><td class="py-2.5 pr-4 text-xs font-medium text-slate-700">LinkedIn post</td><td class="py-2.5 pr-4 text-xs">1:1 or 1.91:1</td><td class="py-2.5 pr-4 text-xs">1200×627 or 1200×1200</td><td class="py-2.5 text-xs text-slate-500">Link preview vs feed post</td></tr>
      <tr><td class="py-2.5 pr-4 text-xs font-medium text-slate-700">Website hero banner</td><td class="py-2.5 pr-4 text-xs">16:9 or 21:9</td><td class="py-2.5 pr-4 text-xs">1200×675 or 1600×686</td><td class="py-2.5 text-xs text-slate-500">Full-width. Under 500KB for CWV.</td></tr>
    </tbody>
  </table></div>

  <h2 class="text-xl font-bold text-slate-900 mt-10 mb-4">Freeform Crop vs Preset Ratios</h2>
  <p class="text-sm text-slate-600 leading-relaxed mb-3"><strong class="text-slate-800">Freeform</strong> gives you complete control — drag the crop box anywhere, any size. Use this when the exact composition matters more than the final ratio. Good for removing watermarks or isolating a subject.</p>
  <p class="text-sm text-slate-600 leading-relaxed mb-4"><strong class="text-slate-800">Preset ratios</strong> lock the crop to a specific aspect ratio. Use 1:1 for profile pictures and stickers. Use 16:9 for video thumbnails and hero banners. Use 9:16 for Stories and vertical video. Presets ensure your output matches platform expectations exactly.</p>

  <h2 class="text-xl font-bold text-slate-900 mt-10 mb-4">Cropping vs Resizing: What Is the Difference?</h2>
  <p class="text-sm text-slate-600 leading-relaxed mb-3"><strong class="text-slate-800">Cropping</strong> cuts away parts of the image — you are selecting a region and discarding everything outside it. The result has new dimensions based on your selection. Content is permanently removed.</p>
  <p class="text-sm text-slate-600 leading-relaxed mb-4"><strong class="text-slate-800">Resizing</strong> scales the entire image — you are changing the pixel dimensions while keeping all content. Nothing is discarded; everything is scaled proportionally (or stretched, if aspect ratio is unlocked).</p>
  <p class="text-sm text-slate-600 leading-relaxed mb-4">Use cropping to change composition. Use <a href="/resize-gif/" class="text-accent hover:underline">resizing</a> to change dimensions. Use both together for complete control: crop to the right composition and aspect ratio, then resize to the exact pixel dimensions you need.</p>

  
  <h2 class="text-xl font-bold text-slate-900 mt-10 mb-4">Crop GIFs for Specific Platforms — Exact Recipes</h2>

  <h3 class="text-base font-semibold text-slate-800 mt-6 mb-2">Discord Profile Picture (1:1 Square)</h3>
  <p class="text-sm text-slate-600 leading-relaxed mb-2">Discord profile pictures display at 128×128 but you should upload at 512×512 for crisp rendering on high-DPI screens. The crop must be square and centered on the subject:</p>
  <ol class="list-decimal list-inside space-y-1 mb-4 text-sm text-slate-600">
    <li>Select the <strong class="text-slate-800">1:1 ratio</strong> preset</li>
    <li>Position the crop box centered on the face or main subject</li>
    <li>Click Crop GIF</li>
    <li>Use the <a href="/resize-gif/" class="text-accent hover:underline">Resize tool</a> to set the cropped GIF to exactly 512×512</li>
    <li>Compress to well under 20MB (Discord's free-tier cap for profile pictures)</li>
  </ol>

  <h3 class="text-base font-semibold text-slate-800 mt-6 mb-2">Instagram Story (9:16 Vertical)</h3>
  <p class="text-sm text-slate-600 leading-relaxed mb-2">Instagram Stories are full-screen vertical at 1080×1920. Most source GIFs are landscape — cropping to 9:16 means losing most of the width:</p>
  <ol class="list-decimal list-inside space-y-1 mb-4 text-sm text-slate-600">
    <li>Select the <strong class="text-slate-800">9:16 ratio</strong> preset</li>
    <li>Position the crop box on the most important vertical slice of your content</li>
    <li>After cropping, <a href="/resize-gif/" class="text-accent hover:underline">resize to 1080×1920</a></li>
    <li>Consider converting to <a href="/gif-to-mp4/" class="text-accent hover:underline">MP4</a> — Instagram automatically converts GIF uploads to video and MP4 gives you better quality control</li>
  </ol>

  <h3 class="text-base font-semibold text-slate-800 mt-6 mb-2">Twitter Header (3:1 Ultra-Wide)</h3>
  <p class="text-sm text-slate-600 leading-relaxed mb-2">Twitter profile headers are 1500×500 (3:1 ratio). This extreme aspect ratio means you will lose most of the image:</p>
  <ol class="list-decimal list-inside space-y-1 mb-4 text-sm text-slate-600">
    <li>Switch to <strong class="text-slate-800">Freeform</strong> mode (no preset supports 3:1)</li>
    <li>Set the crop dimensions manually: width should be the full image width, height should be width ÷ 3</li>
    <li>Center vertically on the most interesting horizontal band</li>
    <li>After cropping, resize to 1500×500</li>
    <li>Keep the animated header under 5MB — Twitter applies its own compression on top</li>
  </ol>

  <h3 class="text-base font-semibold text-slate-800 mt-6 mb-2">YouTube Thumbnail (16:9)</h3>
  <p class="text-sm text-slate-600 leading-relaxed mb-2">YouTube thumbnails are 1280×720 (16:9). For animated thumbnails (which YouTube supports as short GIF-like previews), use the 16:9 crop:</p>
  <ol class="list-decimal list-inside space-y-1 mb-4 text-sm text-slate-600">
    <li>Select the <strong class="text-slate-800">16:9 ratio</strong> preset</li>
    <li>Position to include the most compelling visual elements — YouTube thumbnails are small in search results</li>
    <li>Resize to 1280×720 after cropping</li>
    <li>Keep under 2MB — YouTube has file size limits for custom thumbnails</li>
  </ol>

  <h2 class="text-xl font-bold text-slate-900 mt-10 mb-4">Crop + Resize + Compress: The Complete Workflow</h2>
  <p class="text-sm text-slate-600 leading-relaxed mb-4">The three operations — crop, resize, and compress — form a pipeline. Each step permanently removes data, making the next step more effective. The correct order is immutable:</p>
  <div class="overflow-x-auto mb-6"><table class="w-full text-sm border-collapse">
    <thead><tr class="border-b-2 border-slate-200 text-left"><th class="py-2.5 pr-4 text-slate-500 font-medium text-xs">Step</th><th class="py-2.5 pr-4 text-slate-500 font-medium text-xs">Operation</th><th class="py-2.5 pr-4 text-slate-500 font-medium text-xs">Starting size</th><th class="py-2.5 text-slate-500 font-medium text-xs">Result</th></tr></thead>
    <tbody>
      <tr class="border-b border-slate-100"><td class="py-2.5 pr-4 text-xs font-medium text-accent">1</td><td class="py-2.5 pr-4 text-xs font-medium text-slate-700">Crop</td><td class="py-2.5 pr-4 text-xs">8.2 MB</td><td class="py-2.5 text-xs">5.1 MB (removed 38% of area)</td></tr>
      <tr class="border-b border-slate-100"><td class="py-2.5 pr-4 text-xs font-medium text-accent">2</td><td class="py-2.5 pr-4 text-xs font-medium text-slate-700"><a href="/resize-gif/" class="text-accent hover:underline">Resize</a> to 600px</td><td class="py-2.5 pr-4 text-xs">5.1 MB</td><td class="py-2.5 text-xs">1.4 MB (reduced pixel count by 73%)</td></tr>
      <tr class="border-b border-slate-100 bg-accent/[0.02]"><td class="py-2.5 pr-4 text-xs font-medium text-accent">3</td><td class="py-2.5 pr-4 text-xs font-medium text-slate-700"><a href="/" class="text-accent hover:underline">Compress</a> at Balanced 60</td><td class="py-2.5 pr-4 text-xs">1.4 MB</td><td class="py-2.5 text-xs text-accent font-medium">420 KB (95% total reduction)</td></tr>
    </tbody>
  </table></div>
  <p class="text-sm text-slate-600 leading-relaxed mb-4">The workflow is deterministic: crop → resize → compress. Any other order wastes processing on pixels you will later discard. This three-step pipeline is how professional media pipelines handle asset preparation, and it is why our tools are designed to work as a connected suite rather than isolated utilities.</p>

  <h2 class="text-xl font-bold text-slate-900 mt-10 mb-4">When Cropping Is the Wrong Tool</h2>
  <p class="text-sm text-slate-600 leading-relaxed mb-4">Cropping permanently removes content. If you later need the full image, there is no undo. Before cropping, ask yourself:</p>
  <ul class="space-y-2 mb-6">
    <li class="text-sm text-slate-600"><strong class="text-slate-800">Is the unwanted area truly unnecessary?</strong> A watermark, blank border, or taskbar in a screen recording is fair game. But cropping out context that someone might need later is irreversible — keep the original file.</li>
    <li class="text-sm text-slate-600"><strong class="text-slate-800">Would resizing achieve the same goal?</strong> If you just want a smaller file, <a href="/resize-gif/" class="text-accent hover:underline">resizing</a> scales everything proportionally without removing content. Cropping should be reserved for when you specifically want to remove part of the image.</li>
    <li class="text-sm text-slate-600"><strong class="text-slate-800">Is the crop ratio platform-compatible?</strong> Cropping to an unusual aspect ratio may look fine on your screen but will be letterboxed or further cropped by the target platform. Always check the platform's expected ratios before cropping.</li>
  </ul>

  <h2 class="text-xl font-bold text-slate-900 mt-10 mb-4">Cropping GIFs: common questions</h2>
  <div class="space-y-3 mb-8">
    <details class="group tool-card p-4">
      <summary class="text-sm font-medium text-slate-900 cursor-pointer list-none flex justify-between items-center">
        Can I crop an animated GIF without losing animation?
        <span class="text-slate-400 group-open:rotate-180 transition-transform">&#9662;</span>
      </summary>
      <p class="text-xs text-slate-500 mt-3 leading-relaxed">Yes. Every frame is cropped with the same rectangle, and frame delays and disposal methods are copied through unchanged. The result plays at exactly the original speed, only inside the area you selected.</p>
    </details>
    <details class="group tool-card p-4">
      <summary class="text-sm font-medium text-slate-900 cursor-pointer list-none flex justify-between items-center">
        What aspect ratios can I crop to?
        <span class="text-slate-400 group-open:rotate-180 transition-transform">&#9662;</span>
      </summary>
      <p class="text-xs text-slate-500 mt-3 leading-relaxed">You can crop freely, or lock the selection to a preset ratio: 1:1 (square), 4:3, 3:4, 16:9 and 9:16 (vertical). Square is the shape profile pictures and stickers need; 9:16 is the shape of a phone screen.</p>
    </details>
    <details class="group tool-card p-4">
      <summary class="text-sm font-medium text-slate-900 cursor-pointer list-none flex justify-between items-center">
        Does cropping a GIF reduce its file size?
        <span class="text-slate-400 group-open:rotate-180 transition-transform">&#9662;</span>
      </summary>
      <p class="text-xs text-slate-500 mt-3 leading-relaxed">Yes. Cropping deletes pixels from every frame, so the file gets smaller. A crop that keeps half the width and half the height kept between a fifth and a half of the original weight in our own tests, depending on how much of the animation moves. Compress the cropped file afterwards for the rest.</p>
    </details>
    <details class="group tool-card p-4">
      <summary class="text-sm font-medium text-slate-900 cursor-pointer list-none flex justify-between items-center">
        How do I cut out a watermark or a fixed region?
        <span class="text-slate-400 group-open:rotate-180 transition-transform">&#9662;</span>
      </summary>
      <p class="text-xs text-slate-500 mt-3 leading-relaxed">Type the X and Y of the top-left corner you want to keep plus the width and height, all in the original GIF's own pixels, then press <strong class="text-slate-700">Crop GIF</strong>. The preview below the editor plays the real output, so you can check that the watermark is gone before downloading.</p>
    </details>
  </div>

<div class="mt-8 pt-6 border-t border-slate-100">
    <p class="text-xs text-slate-400">Related: <a href="/resize-gif/" class="text-accent hover:underline">Resize GIF</a> &middot; <a href="/" class="text-accent hover:underline">Compress GIF</a> &middot; <a href="/gif-to-webp/" class="text-accent hover:underline">GIF to WebP</a> &middot; <a href="/gif-optimizer/" class="text-accent hover:underline">GIF Optimizer</a></p>
  </div>
</article>
</Base>

<script>
  const dropZone = document.getElementById("crop-tool");
  const fileInput = document.getElementById("file-input");
  const selectBtn = document.getElementById("select-btn");
  const editorPanel = document.getElementById("editor-panel");
  const stage = document.getElementById("crop-stage");
  const canvas = document.getElementById("crop-canvas");
  const overlay = document.getElementById("crop-overlay");
  const cropX = document.getElementById("crop-x");
  const cropY = document.getElementById("crop-y");
  const cropW = document.getElementById("crop-w");
  const cropH = document.getElementById("crop-h");
  const applyBtn = document.getElementById("apply-btn");
  const downloadBtn = document.getElementById("download-btn");
  const statusEl = document.getElementById("crop-status");
  const resultWrap = document.getElementById("result-wrap");
  const resultImg = document.getElementById("crop-result");
  const resultNote = document.getElementById("crop-note");
  const srcDims = document.getElementById("src-dims");
  const urlInput = document.getElementById("url-input");
  const urlLoadBtn = document.getElementById("url-load-btn");

  let natW = 0, natH = 0, srcFile = null, resultBlob = null, runSeq = 0;

  // gifsicle is fetched on first use, not on page load: the WASM engine would
  // otherwise compete with the LCP image for critical bandwidth.
  let enginePromise = null;
  function loadEngine() {
    if (!enginePromise) {
      enginePromise = import("https://esm.sh/gifsicle-wasm-browser").then((gs) => gs.default);
    }
    return enginePromise;
  }

  selectBtn.addEventListener("click", (e) => { e.stopPropagation(); fileInput.click(); });
  dropZone.addEventListener("click", () => fileInput.click());
  fileInput.addEventListener("change", (e) => { if (e.target.files[0]) loadFile(e.target.files[0]); });
  urlLoadBtn.addEventListener("click", async () => {
    const u = (urlInput.value || "").trim();
    if (!u) return;
    try {
      const r = await fetch(u);
      if (!r.ok) throw new Error;
      const b = await r.blob();
      urlInput.value = "";
      loadFile(new File([b], u.split("/").pop() || "remote.gif", { type: "image/gif" }));
    } catch { alert("Could not load GIF from URL."); }
  });
  urlInput.addEventListener("keydown", (e) => { if (e.key === "Enter") urlLoadBtn.click(); });
  dropZone.addEventListener("dragover", (e) => { e.preventDefault(); dropZone.classList.add("border-accent","bg-accent/5"); });
  dropZone.addEventListener("dragleave", () => dropZone.classList.remove("border-accent","bg-accent/5"));
  dropZone.addEventListener("drop", (e) => { e.preventDefault(); dropZone.classList.remove("border-accent","bg-accent/5"); if (e.dataTransfer.files[0]) loadFile(e.dataTransfer.files[0]); });

  function loadFile(file) {
    srcFile = file;
    resultBlob = null;
    downloadBtn.disabled = true;
    resultWrap.classList.add("hidden");
    const preview = URL.createObjectURL(file);
    const img = new Image();
    img.onload = () => {
      natW = img.naturalWidth; natH = img.naturalHeight;
      // A canvas is only a still-frame picker here: drawImage() of an animated
      // GIF paints frame one, so it is kept at a bounded display width and the
      // real encoding is done by gifsicle on the original file.
      const dispW = Math.min(800, natW);
      canvas.width = dispW;
      canvas.height = dispW * natH / natW;
      canvas.getContext("2d").drawImage(img, 0, 0, dispW, canvas.height);
      srcDims.textContent = `· ${natW} × ${natH} px source`;
      cropW.max = natW; cropH.max = natH;
      cropW.value = Math.round(natW * 0.5);
      cropH.value = Math.round(natH * 0.5);
      cropX.value = Math.round(natW * 0.25);
      cropY.value = Math.round(natH * 0.25);
      updateOverlay();
      dropZone.classList.add("hidden");
      editorPanel.classList.remove("hidden");
      statusEl.textContent = "Drag the box or type coordinates in source pixels, then crop every frame.";
    };
    img.onerror = () => { alert("That file is not a readable GIF."); };
    img.src = preview;
  }

  // The box is placed in percentages of the canvas box, so it stays glued to the
  // picture even when CSS shrinks the canvas below its own pixel width.
  function updateOverlay() {
    const x = clampInt(cropX.value, 0, natW - 1);
    const y = clampInt(cropY.value, 0, natH - 1);
    const w = clampInt(cropW.value, 1, natW - x);
    const h = clampInt(cropH.value, 1, natH - y);
    overlay.style.left = (100 * x / natW) + "%";
    overlay.style.top = (100 * y / natH) + "%";
    overlay.style.width = (100 * w / natW) + "%";
    overlay.style.height = (100 * h / natH) + "%";
    overlay.classList.remove("hidden");
  }

  function clampInt(v, lo, hi) {
    const n = parseInt(v, 10);
    if (!Number.isFinite(n)) return lo;
    return Math.max(lo, Math.min(hi, n));
  }

  // CSS pixels under the cursor to source pixels: the canvas is scaled twice
  // (down to the display width, then again by max-w-full on narrow screens).
  function sourceScale() {
    const rect = stage.getBoundingClientRect();
    return rect.width > 0 && natW > 0 ? natW / rect.width : 1;
  }

  [cropX, cropY, cropW, cropH].forEach(el => el.addEventListener("input", () => { if (natW > 0) updateOverlay(); }));

  document.querySelectorAll(".ratio-btn").forEach(btn => {
    btn.addEventListener("click", () => {
      if (natW <= 0) return;
      document.querySelectorAll(".ratio-btn").forEach(b => { b.classList.remove("bg-slate-100"); });
      btn.classList.add("bg-slate-100");
      if (btn.dataset.ratio === "free") return;
      const [rw, rh] = btn.dataset.ratio.split(":").map(Number);
      const size = Math.min(natW / rw, natH / rh);
      cropW.value = Math.round(size * rw);
      cropH.value = Math.round(size * rh);
      cropX.value = Math.round((natW - cropW.value) / 2);
      cropY.value = Math.round((natH - cropH.value) / 2);
      updateOverlay();
    });
  });

  let isDragging = false, grabDX = 0, grabDY = 0;
  overlay.addEventListener("mousedown", (e) => {
    e.preventDefault();
    const s = sourceScale();
    const rect = stage.getBoundingClientRect();
    isDragging = true;
    grabDX = (e.clientX - rect.left) * s - clampInt(cropX.value, 0, natW - 1);
    grabDY = (e.clientY - rect.top) * s - clampInt(cropY.value, 0, natH - 1);
  });
  document.addEventListener("mousemove", (e) => {
    if (!isDragging || natW <= 0) return;
    const s = sourceScale();
    const rect = stage.getBoundingClientRect();
    const w = clampInt(cropW.value, 1, natW);
    const h = clampInt(cropH.value, 1, natH);
    cropX.value = clampInt(Math.round((e.clientX - rect.left) * s - grabDX), 0, natW - w);
    cropY.value = clampInt(Math.round((e.clientY - rect.top) * s - grabDY), 0, natH - h);
    updateOverlay();
  });
  document.addEventListener("mouseup", () => { isDragging = false; });

  downloadBtn.addEventListener("click", () => {
    if (!resultBlob) return;
    const url = URL.createObjectURL(resultBlob);
    const a = document.createElement("a");
    a.href = url; a.download = "cropped.gif"; a.click();
    URL.revokeObjectURL(url);
  });

  // A canvas cannot encode an animated GIF — toBlob silently falls back to PNG,
  // which flattened every crop to frame one. gifsicle crops the whole stream and
  // keeps frame timing and disposal intact, so it is the encoder here. The
  // geometry form is deliberately "X,Y+WxH": the "WxH+X+Y" spelling repositions
  // the canvas instead of selecting a region, and returned the wrong pixels.
  async function runCrop() {
    if (!srcFile || natW <= 0) return;
    const x = clampInt(cropX.value, 0, natW - 1);
    const y = clampInt(cropY.value, 0, natH - 1);
    const w = clampInt(cropW.value, 1, natW - x);
    const h = clampInt(cropH.value, 1, natH - y);

    const seq = ++runSeq;
    downloadBtn.disabled = true;
    applyBtn.disabled = true;
    statusEl.textContent = "Cropping all frames...";

    try {
      const gifsicle = await loadEngine();
      const [outFile] = await gifsicle.run({
        input: [{ file: srcFile, name: "input.gif" }],
        command: [`--crop ${x},${y}+${w}x${h} input.gif -o /out/output.gif`],
      });
      if (seq !== runSeq) return;

      const dims = await readGifDims(outFile);
      if (!dims) {
        statusEl.textContent = "The result was not a GIF. If the file is not animated, try the compressor instead.";
        return;
      }

      resultBlob = outFile;
      const url = URL.createObjectURL(outFile);
      resultImg.src = url;
      resultWrap.classList.remove("hidden");
      const saved = Math.max(0, Math.round((1 - outFile.size / srcFile.size) * 100));
      resultNote.textContent =
        `${dims.w} x ${dims.h} px · ${formatSize(outFile.size)} · ` +
        `${x},${y} selected from your ${natW} x ${natH} source · every frame cropped, animation timing preserved`;
      statusEl.textContent = `Saved ${saved}% by dropping from ${natW} x ${natH} to ${dims.w} x ${dims.h}. Download below, or adjust the box and crop again.`;
      downloadBtn.disabled = false;
    } catch {
      if (seq !== runSeq) return;
      statusEl.textContent = "Could not crop this file. If it is not an animated GIF, use the compressor instead.";
      downloadBtn.disabled = true;
    } finally {
      if (seq === runSeq) applyBtn.disabled = false;
    }
  }

  applyBtn.addEventListener("click", runCrop);

  async function readGifDims(blob) {
    if (!blob || blob.size < 10) return null;
    const head = new Uint8Array(await blob.slice(0, 10).arrayBuffer());
    const sig = String.fromCharCode(head[0], head[1], head[2], head[3], head[4], head[5]);
    if (sig !== "GIF87a" && sig !== "GIF89a") return null;
    return {
      w: head[6] | (head[7] << 8),
      h: head[8] | (head[9] << 8),
    };
  }

  function formatSize(bytes) {
    if (bytes >= 1048576) return (bytes / 1048576).toFixed(1) + " MB";
    if (bytes >= 1024) return (bytes / 1024).toFixed(0) + " KB";
    return bytes + " B";
  }
</script>
