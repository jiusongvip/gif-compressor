---
import Base from "../layouts/Base.astro";
---
<Base
  title="Page Not Found — GIF Compress"
  description="The page you were looking for could not be found. Try our free online GIF compressor to reduce animated GIF file size up to 70% in your browser."
>
  <meta slot="head" name="robots" content="noindex, follow" />
  <section class="max-w-2xl mx-auto px-4 py-24 text-center">
    <p class="text-6xl font-bold text-accent mb-2">404</p>
    <h1 class="text-2xl font-bold text-slate-900 mb-3">This GIF got compressed right out of existence</h1>
    <p class="text-slate-500 mb-8">The page you're looking for doesn't exist or has moved.</p>
    <div class="flex items-center justify-center gap-3">
      <a href="/" class="px-5 py-2.5 bg-accent text-white text-sm font-medium rounded-lg hover:bg-accent-dark transition-colors">Back to home</a>
      <a href="/compress-gif/" class="px-5 py-2.5 border border-slate-300 text-slate-700 text-sm font-medium rounded-lg hover:border-accent hover:text-accent transition-colors">Compress a GIF</a>
    </div>
  </section>
</Base>
