---
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  schema?: string;
  schemas?: string[];
}

const { title, description = "Free online GIF compression tool. Reduce animated GIF file size instantly. Processed in your browser - files never uploaded.", ogImage = "/og-default.png", schema, schemas = [] } = Astro.props;

// 多个 JSON-LD 必须拆分为独立 <script> 标签，拼接在单个标签内是非法 JSON
const allSchemas = [...(schema ? [schema] : []), ...schemas];

const path = Astro.url.pathname;
const segments = path.replace(/\/$/, '').split('/').filter(Boolean);
const siteUrl = (import.meta.env.SITE || '').replace(/\/$/, '');
// 首页根域例外：canonical/og:url 首页不带尾斜杠，内页带尾斜杠
const canonicalUrl = path === '/' ? siteUrl : siteUrl + path;
// og:image 必须为绝对 URL
const ogImageUrl = ogImage.startsWith('http') ? ogImage : new URL(ogImage, siteUrl + '/').href;
const breadcrumbItems = [{ name: 'Home', url: '/' }];
let accum = '';
for (const seg of segments) {
  accum += '/' + seg;
  breadcrumbItems.push({ name: seg.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase()), url: accum });
}
const breadcrumbSchema = breadcrumbItems.length > 1 ? JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbItems.map((item, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": item.name,
    // 内页 URL 带尾斜杠（首页根域例外）
    "item": new URL(item.url === '/' ? '/' : item.url + '/', siteUrl + '/').href
  }))
}) : null;
---
<!doctype html>
<html lang="en">
  <head>
    <!-- Google Analytics：延迟到浏览器空闲/载入后注入，避免占用首屏关键资源带宽、拖慢 LCP 与 TTI -->
    <script is:inline>
      (() => {
        const loadGA = () => {
          if (window.__gaLoaded) return; window.__gaLoaded = true;
          window.dataLayer = window.dataLayer || [];
          function gtag(){ dataLayer.push(arguments); }
          window.gtag = gtag;
          gtag('js', new Date());
          gtag('config', 'G-N2KTR7FRKD');
          const s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=G-N2KTR7FRKD';
          document.head.appendChild(s);
        };
        if ('requestIdleCallback' in window) requestIdleCallback(loadGA, { timeout: 4000 });
        else setTimeout(loadGA, 1500);
        window.addEventListener('load', () => setTimeout(loadGA, 1200));
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="GIF Compress" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <!-- 自托管 Geist 变量字体（latin 子集，本地文件）：不再请求 Google Fonts；
         以 low 优先级预加载，保证 LCP 图（High）优先获得带宽，字体到位后 swap 替换 -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/geist-latin-var.woff2" crossorigin fetchpriority="low" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#2563EB" />
    {allSchemas.map((s) => <script type="application/ld+json" set:html={s} />)}
    {breadcrumbSchema && <script type="application/ld+json" set:html={breadcrumbSchema} />}
    <slot name="head" />
  </head>
  <body class="min-h-[100dvh] flex flex-col">
    <script>
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('/sw.js');
      }
    </script>
    <Nav />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
